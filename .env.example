# ============================================================
# CityPulse 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入真实值

# 数据库：PostgreSQL + PostGIS（docker-compose 已提供本地实例）
# 启动：docker compose up -d && npm run db:migrate && npm run db:seed
DATABASE_URL="postgresql://citypulse:citypulse@localhost:5432/citypulse?schema=public"
# 提示：未启动数据库也能运行（读路径回退 mock），但登录/写操作需要数据库

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (可选，按需配置)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mapbox（地图渲染 / Directions 步行路线 / Geocoding 搜索）
# 未配置时地图显示占位，搜索/导航优雅降级
NEXT_PUBLIC_MAPBOX_TOKEN=""
# 可选：自定义地图样式（Mapbox Studio）
NEXT_PUBLIC_MAPBOX_STYLE=""

# Cloudinary（图片上传，使用 unsigned upload preset）
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Redis 缓存（Upstash REST，未配置时回退进程内内存缓存）
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Meilisearch 全文搜索（未配置时回退仓储层 + 内存过滤）
MEILI_HOST=""
MEILI_API_KEY=""

# Web Push（VAPID 密钥，未配置时「开启推送」按钮优雅提示）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

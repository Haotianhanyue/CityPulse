{
  "name": "citypulse-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "CityPulse 微信小程序（Taro + React + TypeScript）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5"
  },
  "browserslist": ["defaults and fully supports es6-module", "maintained node versions"],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "3.6.34",
    "@tarojs/helper": "3.6.34",
    "@tarojs/plugin-framework-react": "3.6.34",
    "@tarojs/plugin-platform-weapp": "3.6.34",
    "@tarojs/react": "3.6.34",
    "@tarojs/runtime": "3.6.34",
    "@tarojs/shared": "3.6.34",
    "@tarojs/taro": "3.6.34",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@tarojs/cli": "3.6.34",
    "@tarojs/webpack5-runner": "3.6.34",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "3.6.34",
    "sass": "^1.77.0",
    "typescript": "^5.4.0",
    "webpack": "5.91.0"
  }
}
